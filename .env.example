# Telegram factory bot token (create with @BotFather)
FACTORY_BOT_TOKEN=
# PostgreSQL / Neon
DATABASE_URL=
# 32-byte key encoded as 64 hex characters; generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Telegram channel that every generated bot must enforce
REQUIRED_CHANNEL_ID=@K_J6k
REQUIRED_CHANNEL_URL=https://t.me/K_J6k
# Private service-to-service HMAC key (at least 32 random bytes)
FACTORY_SERVICE_SECRET=
# Public deployment URL, e.g. https://your-factory.vercel.app
PUBLIC_BASE_URL=
# Optional: owner Telegram IDs, comma-separated
FACTORY_ADMIN_IDS=
