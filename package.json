{
  "name": "telegram-bot-factory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "tsc --noEmit",
    "register:webhook": "node scripts/register-webhook.mjs",
    "vercel-build": "npm run build && if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run register:webhook; fi"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
