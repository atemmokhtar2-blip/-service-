# Telegram factory bot token (create with @BotFather)
FACTORY_BOT_TOKEN=
# PostgreSQL / Neon
DATABASE_URL=
# 32-byte key encoded as 64 hex characters; generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Telegram channel that every generated bot must enforce
REQUIRED_CHANNEL_ID=@K_J6k
REQUIRED_CHANNEL_URL=https://t.me/K_J6k
# Private service-to-service HMAC key (at least 32 random bytes)
FACTORY_SERVICE_SECRET=
# Public deployment URL, e.g. https://your-factory.vercel.app
PUBLIC_BASE_URL=
# Optional: owner Telegram IDs, comma-separated
FACTORY_ADMIN_IDS=

# Source adapter endpoints (set on the Factory deployment)
DOWNLOAD_PROVISION_URL=
PRECRIME_PROVISION_URL=
MARAYTI_PROVISION_URL=

# Optional Telegram support username used for paid edit-credit purchases (without @)
FACTORY_SUPPORT_USERNAME=

# Optional: email a copy of every new edit request to an intake inbox.
# Disabled unless set to "true"; when disabled nothing changes in the request flow.
# See docs/EDIT_INTAKE.md before enabling.
EDIT_INTAKE_EMAIL_ENABLED=false
# Required explicit activation moment (ISO 8601, e.g. 2026-11-24T08:00:00Z), set by the
# operator BEFORE enabling. Backfill only recovers requests created at or after this
# moment; requests created before it are never emailed. When this is empty or invalid
# the whole intake fails closed: nothing is enqueued, recovered, or sent.
EDIT_INTAKE_ACTIVATED_AFTER=
# Destination inbox that receives the intake copy
EDIT_INTAKE_EMAIL_TO=
# Gmail address that sends the copy; it must be the account that authorized the refresh token
GOOGLE_INTAKE_SENDER=
# OAuth2 web-client credentials restricted to scope https://www.googleapis.com/auth/gmail.send
GOOGLE_INTAKE_CLIENT_ID=
GOOGLE_INTAKE_CLIENT_SECRET=
GOOGLE_INTAKE_REFRESH_TOKEN=
# Optional explicit selector: database uses the encrypted token from the owner consent flow.
# Empty preserves env-token behavior; selecting database never enables the intake.
GOOGLE_INTAKE_AUTH_SOURCE=
# Secret that protects the intake reconciliation cron route (Vercel sends it as a bearer token)
CRON_SECRET=

# Optional one-time OAuth setup routes for the intake sender (docs/EDIT_INTAKE_SETUP.md).
# Disabled unless "true"; when disabled both routes return 404 and nothing is created.
# Enable only for the few minutes of the owner consent flow, then unset again.
INTAKE_SETUP_ENABLED=false
# Owner key entered through the secure setup form, never a URL or chat.
# At least 32 random bytes (openssl rand -hex 32).
INTAKE_SETUP_OWNER_TOKEN=
